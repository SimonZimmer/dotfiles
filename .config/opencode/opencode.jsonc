{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git": "deny",
      "gh": "deny",
      "kubectl *": "deny",
      "kubectl": "deny",
      "terraform": "deny",
      "terragrunt": "deny"
    },
    "edit": {
      "**": "allow"
    },
    "read": {
      "**": "allow"
    }
  },
  "agent": {
    "nvim-maintainer": {
      "description": "Adjusts nvim config",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "prompt": "You are a neovim maintainer. Focus on editing the custom nvim config located at ~/.config/nvim.",
      "tools": {
        "write": true,
        "edit": false
      }
    }
  },
  "plugin": [
    "./plugins/graphify-context/plugin.js",
    "./plugins/caveman/plugin.js",
    "@slkiser/opencode-quota@latest"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:32b": {
          "tools": true
        }
      }
    },
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {}
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13",
      "oauth": {},
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "terraform-mcp-server"
      ],
      "enabled": true
    },
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@3.0.0-beta.42",
        "server",
        "start",
        "--mode",
        "namespace",
        "--read-only",
        "--namespace", "acr",
        "--namespace", "adme",
        "--namespace", "advisor",
        "--namespace", "aks",
        "--namespace", "appconfig",
        "--namespace", "applens",
        "--namespace", "applicationinsights",
        "--namespace", "appservice",
        "--namespace", "azureterraform",
        "--namespace", "azureterraformbestpractices",
        "--namespace", "bicepschema",
        "--namespace", "cloudarchitect",
        "--namespace", "communication",
        "--namespace", "compute",
        "--namespace", "containerapps",
        "--namespace", "cosmos",
        "--namespace", "datadog",
        "--namespace", "deploy",
        "--namespace", "deviceregistry",
        "--namespace", "eventgrid",
        "--namespace", "eventhubs",
        "--namespace", "extension",
        "--namespace", "fileshares",
        "--namespace", "foundryextensions",
        "--namespace", "functionapp",
        "--namespace", "functions",
        "--namespace", "get",
        "--namespace", "grafana",
        "--namespace", "group",
        "--namespace", "insights",
        "--namespace", "iothub",
        "--namespace", "keyvault",
        "--namespace", "kusto",
        "--namespace", "loadtesting",
        "--namespace", "marketplace",
        "--namespace", "monitor",
        "--namespace", "mysql",
        "--namespace", "optimization",
        "--namespace", "policy",
        "--namespace", "postgres",
        "--namespace", "pricing",
        "--namespace", "quota",
        "--namespace", "redis",
        "--namespace", "resourcehealth",
        "--namespace", "role",
        "--namespace", "search",
        "--namespace", "servicebus",
        "--namespace", "servicefabric",
        "--namespace", "signalr",
        "--namespace", "speech",
        "--namespace", "sql",
        "--namespace", "storage",
        "--namespace", "subscription",
        "--namespace", "virtualdesktop",
        "--namespace", "wellarchitectedframework",
        "--namespace", "workbooks"
      ],
      "enabled": true
    }
  },
  "command": {
    "graphify": {
      "description": "Turn current directory into a navigable knowledge graph",
      "template": "The user invoked /graphify. Load the graphify skill and execute the full graphify pipeline on the current directory."
    }
  },
  "experimental": {
    "caveman_default_level": "full"
  },
  "lsp": true
}
