{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "deny",
      "git": "deny",
      "gh": "deny",
      "kubectl *": "deny",
      "kubectl": "deny",
      "terraform": "deny",
      "terragrunt": "deny"
    },
    "edit": {
      "**": "allow"
    },
    "read": {
      "**": "allow"
    }
  },
  "agent": {
    "nvim-maintainer": {
      "description": "Adjusts nvim config",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "prompt": "You are a neovim maintainer. Focus on editing the custom nvim config located at ~/.config/nvim.",
      "tools": {
        "write": true,
        "edit": false
      }
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "plugin": [
    "./plugins/graphify-context/plugin.js",
    "./plugins/caveman/plugin.js",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:32b": {
          "tools": true
        }
      }
    },
    "copilot": {},
    "openai": {}
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "jira": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "jira-mcp"
      ],
      "enabled": true,
      "env": {
        "JIRA_INSTANCE_URL": "{env:JIRA_INSTANCE_URL}",
        "JIRA_USER_EMAIL": "{env:JIRA_USER_EMAIL}",
        "JIRA_API_KEY": "{env:JIRA_API_KEY}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "terraform-mcp-server"
      ],
      "enabled": true
    }
  },
  "command": {
    "graphify": {
      "description": "Turn current directory into a navigable knowledge graph",
      "template": "The user invoked /graphify. Load the graphify skill and execute the full graphify pipeline on the current directory."
    }
  },
  "experimental": {
    "caveman_default_level": "full"
  },
  "lsp": true
}
